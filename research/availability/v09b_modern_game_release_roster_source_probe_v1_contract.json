  "semantic_markers": {
    "release_marker_any": ["GAME RELEASE", "WEEKLY RELEASE", "WEEKLY PRESS RELEASE"],
    "current_roster_marker_any": ["NUMERICAL ROSTER", "ALPHABETICAL ROSTER", "ROSTERS & DEPTH CHART"],
    "excluded_population_marker_any": ["PRACTICE SQUAD", "RESERVE/INJURED", "INJURED RESERVE", "RESERVE/PUP", "RESERVE/COVID-19", "RESERVE/NFI", "RESERVE/NON FOOTBALL INJURY"],
    "dated_snapshot_required": true,
    "pregame_snapshot_required": true,
    "maximum_snapshot_age_days_for_viability": 7,
