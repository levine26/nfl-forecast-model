      "WAIVED_RELEASED",
      "ELEVATED_ACTIVATED",
      "UNRESOLVED_CHRONOLOGY"
    ],
    "game_day_designation_states": [
      "EXPLICIT_ACTIVE",
      "EXPLICIT_INACTIVE",
      "ACTIVE_BUT_UNABLE_AFTER_DESIGNATION",
      "NOT_APPLICABLE_NOT_ROSTER_ELIGIBLE",
      "UNRESOLVED_DESIGNATION"
    ],
    "multi_event_timeline_required": true,
    "terminal_state_is_latest_explicit_event_provably_before_kickoff": true,
    "absence_from_official_inactive_list_may_not_create_EXPLICIT_ACTIVE": true,
    "DNP_section_presence_may_not_create_EXPLICIT_ACTIVE_or_roster_eligibility": true
  },
  "row_classification_requirements": {
    "each_of_17_rows_must_be_emitted_exactly_once": true,
    "each_classified_row_must_include_supporting_source_ids": true,
    "each_supporting_source_must_include_exact_quote_or_bounded_evidence_excerpt": true,
    "contradictory_first_party_sources_force_UNRESOLVED_CHRONOLOGY_or_UNRESOLVED_DESIGNATION": true,
    "unresolved_rows_are_preserved_not_forced": true
  },
  "partition_diagnostics": {
    "active_max_explanation_metric": "For each of the six active-max contradiction partitions, count DNP rows with explicit pre-kickoff evidence proving either EXPLICIT_INACTIVE, NOT_APPLICABLE_NOT_ROSTER_ELIGIBLE, or another frozen non-active designation. Compare descriptively with the predecessor minimum_dnp_non_active_required_by_active_max. No threshold grants authority.",
    "total_roster_max_explanation_metric": "Record whether DNP-row chronology alone can explain a total-roster-max contradiction. The experiment must not force an explanation when contamination may reside in Not Active or another section.",
    "all_seven_partitions_must_be_reported_even_if_unresolved": true,
    "diagnostic_success_means_complete_accounting_not_semantic_qualification": true
  },
  "forbidden_inferences": [
    "DNP equals active",
    "weekly roster ACT equals game-day active",
    "weekly roster INA equals game-day inactive",
    "A01 is a unique active code",
    "absence from Not Active equals active",
    "absence from an official inactive list equals active",
    "source absence equals active or healthy",
    "postgame snaps, participation, play-by-play, lineup, or substitution evidence as training authority",
    "status fields for identity matching or tie-breaking",
    "manual player exceptions promoted into a production rule",
    "completed 2026 outcomes",
    "2022-2025 validation data for training-rule design",
    "model fitting"
  ],
  "required_outputs": [
    "source manifest with URL, final URL, HTTP status, retrieval UTC, publication timestamp/date if available, SHA256, first-party verdict, pre-kickoff verdict, and rejection reason if non-authoritative",
    "17-row chronology table with identity, ordered explicit events, roster-eligibility state, game-day-designation state, supporting source ids, and unresolved reason where applicable",
    "seven-partition accounting table comparing explicit non-active DNP evidence with predecessor contradiction lower bounds",
    "bounded rejected-evidence table for postgame, generic-current, or chronology-insufficient sources",
    "aggregate diagnostic receipt explicitly preserving zero qualification authority"
