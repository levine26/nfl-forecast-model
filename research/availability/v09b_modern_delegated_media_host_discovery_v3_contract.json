      "official_origin_url": "https://media.clevelandbrowns.com/",
      "expected_delegated_host": "browns.1rmg.com",
      "delegation_kind": "root_redirect"
    },
    {
      "team": "DEN",
      "team_name": "Denver Broncos",
      "seasons": [2017, 2018, 2019, 2020, 2021],
      "official_origin_url": "https://media.denverbroncos.com/",
