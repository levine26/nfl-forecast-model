      "team_name": "Philadelphia Eagles",
      "seasons": [2017, 2018, 2019, 2020, 2021],
      "official_origin_url": "https://media.philadelphiaeagles.com/wp-sitemap.xml",
      "expected_delegated_host": "eagles.1rmg.com",
      "delegation_kind": "sitemap_redirect"
    }
  ],
  "delegation_requirements": {
