{
  "contract_version": 2,
  "contract_id": "V09B-LEGACY-GAMEBOOK-RAW-ARCHIVE-V2",
  "supersedes_parser_only": "V09B-LEGACY-GAMEBOOK-RAW-ARCHIVE-V1",
  "status": "PREREGISTERED_SOURCE_ONLY_FAIL_CLOSED",
  "purpose": "Re-run the unchanged 2012-2016 first-party raw Game Book qualification gates with a source-structure recognizer corrected for the official heading layout observed during the failed V1 parser audit.",
  "v1_failure_preserved": {
    "v1_parser_version": "V09B-GAMEBOOK-TEXT-STRUCTURE-V1",
    "v1_rule": "Not Active and Did Not Play required trailing colons",
    "empirical_trigger": "Official pdftotext -layout output includes Not Active and Did Not Play as standalone/column heading text without required colons. For 2013, V1 verified and extracted all 256 PDFs but rejected all 256 structure rows solely because the colon-anchored recognizers returned zero headings.",
    "interpretation": "parser-specification failure, not evidence of missing first-party bytes",
    "v1_result_may_be_rewritten": false
  },
  "seasons": [2012, 2013, 2014, 2015, 2016],
  "expected_games_by_season": {"2012": 256, "2013": 256, "2014": 256, "2015": 256, "2016": 256},
  "expected_games_total": 1280,
  "source": {
    "authority": "official NFLGSIS Gamebook.pdf bytes",
    "url_pattern": "https://www.nflgsis.com/{season}/Reg/{week_zero_padded}/{gamekey}/Gamebook.pdf",
    "discovery_crosswalk_is_label_authority": false,
    "required_http_status": 200,
    "required_content_type": "application/pdf",
    "required_pdf_magic": "%PDF"
  },
  "archive": {
    "archive_id": "V09B-LEGACY-GAMEBOOK-BYTES-2012-2016-V2",
