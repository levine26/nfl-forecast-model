    "manifest_path": "manifests/{season}.jsonl",
    "sha256_required": true,
    "append_only_manifest_required": true
  },
  "parser": {
    "implementation": "pdftotext -layout",
    "parser_version": "V09B-GAMEBOOK-TEXT-STRUCTURE-V2",
    "not_active_heading_regex": "(?im)^[ \\t]*Not[ \\t]+Active\\b",
    "did_not_play_heading_regex": "(?im)^[ \\t]*Did[ \\t]+Not[ \\t]+Play\\b",
    "recognition_scope": "line start after layout whitespace; a colon is optional rather than required",
    "not_active_heading_occurrences_minimum": 1,
    "did_not_play_heading_occurrences_minimum": 1,
    "heading_occurrence_maximum": null,
    "headings_must_be_distinct": true,
    "not_active_is_negative_class_source": true,
    "did_not_play_is_negative_class_source": false,
    "player_identity_resolution_performed_in_this_gate": false
  },
  "frozen_qualification_gates": {
    "canonical_game_coverage_rate_required": 1.0,
    "source_bytes_verified_rate_required": 1.0,
    "pdf_text_extraction_rate_required": 1.0,
    "not_active_structure_rate_required": 1.0,
    "did_not_play_structure_rate_required": 1.0,
    "distinct_semantic_structure_rate_required": 1.0,
    "duplicate_canonical_game_rows_allowed": 0,
    "duplicate_source_sha_across_distinct_games_allowed": 0,
    "source_row_errors_allowed": 0,
    "season_game_counts_must_match_frozen_universe": true
  },
  "unchanged_from_v1": [
    "canonical game universe",
    "first-party source authority",
    "content-addressed raw-byte requirements",
    "100% byte/text/structure coverage thresholds",
    "zero duplicate/error thresholds",
